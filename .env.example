# Backend environment variables. Copy to .env in the repo root for local
# development. Never commit .env. On Render, set these in the service settings.

# TomTom Routing + Geocoding API key (free tier, no card): https://developer.tomtom.com
TOMTOM_API_KEY=

# Required when DJANGO_DEBUG is not true. Use a long random value in production.
DJANGO_SECRET_KEY=

# "true" for local development only. Defaults to false.
DJANGO_DEBUG=true

# Comma-separated host names the API answers to. On Render the service host name
# is added automatically. Defaults to localhost only when DJANGO_DEBUG is true.
ALLOWED_HOSTS=

# Comma-separated frontend origins allowed to call the API, e.g.
# https://your-app.vercel.app (no trailing slash). Defaults to the Vite dev
# server only when DJANGO_DEBUG is true.
CORS_ALLOWED_ORIGINS=

# Optional. Logging level: DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO

# Optional. HTTPS redirect (defaults to true when DJANGO_DEBUG is false) and the
# HSTS max-age in seconds (defaults to 3600).
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600

# Frontend variables live in frontend/.env.example.
