# Copy to .env (repo root) for local development. Never commit .env.

# --- Backend (Django) ---
# TomTom Routing + Geocoding API key (free tier, no card): https://developer.tomtom.com
TOMTOM_API_KEY=
# Required when DJANGO_DEBUG is not true.
DJANGO_SECRET_KEY=
# "true" for local development only.
DJANGO_DEBUG=true
# Comma-separated host names.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite, set in frontend env / Vercel) ---
# Backend base URL. Leave empty in local dev (Vite proxies /api to Django).
VITE_API_BASE_URL=
