# Frontend build-time variables. For a local production build, copy to
# frontend/.env.production.local. On Vercel, set these in the project settings.
# Never put secrets here: every VITE_ value is visible in the browser bundle.

# Backend base URL, e.g. https://your-api.onrender.com (no trailing slash).
# Leave empty for local development: the Vite dev server proxies /api to Django.
VITE_API_BASE_URL=
